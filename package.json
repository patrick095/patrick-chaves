{
    "name": "patrick-chaves",
    "version": "1.0.0",
    "private": true,
    "packageManager": "npm@10.9.8",
    "engines": {
        "node": "22.22.3",
        "npm": ">=10.9.0 <11"
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build --configuration production",
        "lint": "ng lint && eslint scripts e2e playwright.config.ts --max-warnings=0",
        "typecheck": "ng build --configuration development --output-path dist/typecheck",
        "test": "ng test --watch=false --coverage",
        "test:watch": "ng test",
        "test:e2e": "playwright test",
        "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:static && npm run test:e2e"
    },
    "dependencies": {
        "@angular/common": "22.0.7",
        "@angular/compiler": "22.0.7",
        "@angular/core": "22.0.7",
        "@angular/platform-browser": "22.0.7",
        "@angular/platform-server": "22.0.7",
        "@angular/router": "22.0.7",
        "@angular/ssr": "22.0.7",
        "@ngx-translate/core": "18.0.0",
        "rxjs": "7.8.2",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@angular/build": "22.0.7",
        "@angular/cli": "22.0.7",
        "@angular/compiler-cli": "22.0.7",
        "@axe-core/playwright": "^4.12.1",
        "@eslint/js": "9.32.0",
        "@playwright/test": "^1.61.1",
        "@types/node": "24.1.0",
        "@vitest/coverage-v8": "4.0.8",
        "angular-eslint": "22.0.0",
        "eslint": "9.32.0",
        "jsdom": "28.0.0",
        "sharp": "0.34.3",
        "typescript": "6.0.2",
        "typescript-eslint": "8.65.0",
        "vitest": "4.0.8"
    }
}
